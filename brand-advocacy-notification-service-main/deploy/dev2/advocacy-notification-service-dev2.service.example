[Unit]
Description=Advocacy Notification Service Dev2
After=network.target

[Service]
Type=simple
WorkingDirectory=/opt/advocacy/notification-service-dev2/current
EnvironmentFile=/opt/advocacy/notification-service-dev2/current/runtime.env
EnvironmentFile=-/etc/advocacy/notification-service-dev2.env
ExecStart=/opt/jdk-21/bin/java -jar /opt/advocacy/notification-service-dev2/current/app.jar --spring.profiles.active=${SPRING_PROFILES_ACTIVE}
Restart=always
RestartSec=5
User=advocacy
Group=advocacy

[Install]
WantedBy=multi-user.target
